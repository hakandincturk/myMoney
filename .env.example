# Local development environment.
# Copy to .env and adjust; .env is git ignored and read by spring-dotenv at startup.
# Every key here has a fallback in application.yaml, so .env is optional.
#
# Production does NOT use this file: systemd injects the same keys through
# /opt/mymoney/config/.env and application-prod.yaml.

# HTTP port. 8080 is often taken by other local services.
SERVER_PORT=8090

# Database
DB_URL=jdbc:postgresql://127.0.0.1:5432/myMoney_prod
DB_USERNAME=hakandincturk
DB_PASSWORD=

# Comma separated list of allowed origins. Unset -> "*" (every origin).
# CORS_ALLOWED_ORIGINS=http://localhost:5173
